 	u8 flag_cnt;			/* 0xc000/0x4000/0x8000/0x0000 */
 	u16 master[6][2];		/* cached 16-bit masters */
 	bool muted[6];
@@ -381,7 +384,6 @@ struct bf_saved {
 	char key[32];
 	u16 preamp;
 	u8 gain[4];
-	u8 gain_cycle;
 	u8 flag_cnt;
 	u16 master[6][2];
 	bool muted[6];
