# Superseded by the driver acting on the button press itself.  Only useful
# against an unpatched driver.
#
# Install:
#   install -Dm755 nonfs/bbf-dim-watch.sh ~/.local/bin/bbf-dim-watch.sh
#   install -Dm644 nonfs/systemd/bbf-dim-watch.service \
#       ~/.config/systemd/user/bbf-dim-watch.service
#   systemctl --user enable --now bbf-dim-watch.service

[Unit]
Description=Mirror the Babyface Pro front-panel DIM button onto the output masters
After=sound.target

[Service]
ExecStart=%h/.local/bin/bbf-dim-watch.sh BabyfacePro
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
